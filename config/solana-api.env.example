# Solana API v1.0.0
SOLANA_NETWORK=mainnet-beta
SOLANA_RPC_URL=
SOLANA_RPC_PROVIDER=
SOLANA_RPC_FALLBACK_URLS=
SOLANA_RPC_TIMEOUT_MS=7500
RPC_CIRCUIT_FAILURE_THRESHOLD=3
RPC_CIRCUIT_COOLDOWN_MS=30000
RPC_MAX_FAILOVER_ATTEMPTS=3
SOLANA_EXPECTED_GENESIS_HASH=
HELIUS_RPC_URL=
HELIUS_API_KEY=
ALLOW_DEV_FALLBACK=false
PWRC_MINT=

# Website-origin Next.js proxy -> backend. Provider/RPC credentials stay backend-only.
POWERCHAIN_API_URL=http://localhost:4000
POWERCHAIN_INTERNAL_API_TOKEN=

# Market resolution order. The canonical v1 route always requires ?mint=<address>.
# The compatibility /api/token/market route may use PWRC_MINT when mint is omitted.
MARKET_PROVIDER_PRIORITY=PYTH,JUPITER_PRICE_V3,COINGECKO,COINMARKETCAP,BIRDEYE,HELIUS_DAS
PRICE_DIVERGENCE_BPS=300

# Jupiter market data. getTokenSupply remains authoritative for supply/decimals.
JUPITER_API_BASE_URL=https://api.jup.ag
JUPITER_API_KEY=
JUPITER_ALLOW_KEYLESS=false
JUPITER_TOKENS_LIQUIDITY_ENABLED=true
JUPITER_MAX_BLOCK_LAG=150

# Pyth Hermes. Production access requires authenticated provider/API configuration.
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_API_KEY=
PYTH_MINT_FEED_MAP_JSON={}
PYTH_MAX_AGE_SECONDS=90
PYTH_MAX_CONFIDENCE_BPS=200

# CoinGecko token-price corroboration by Solana contract address.
COINGECKO_API_BASE_URL=https://pro-api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINGECKO_ALLOW_KEYLESS=false
COINGECKO_MAX_AGE_SECONDS=120

# CoinMarketCap DEX token-price corroboration by Solana token address.
COINMARKETCAP_API_BASE_URL=https://pro-api.coinmarketcap.com
COINMARKETCAP_API_KEY=
COINMARKETCAP_ALLOW_KEYLESS=false
COINMARKETCAP_MAX_AGE_SECONDS=180

# Optional legacy corroboration providers.
BIRDEYE_API_BASE_URL=https://public-api.birdeye.so
BIRDEYE_API_KEY=

# PowerChain Launchpad program deployment registry. Leave absent/unconfigured rather than inventing IDs.
SOLANA_LAUNCHPAD_PROGRAM_REGISTRY_JSON=[]
SOLANA_LAUNCHPAD_REGISTRY_PROGRAM_ID=
SOLANA_LAUNCH_POLICY_PROGRAM_ID=
SOLANA_TOKEN_FACTORY_PROGRAM_ID=
EXPECTED_PROGRAM_FINGERPRINTS_JSON={"launchpad-registry":"<64-hex>","launch-policy":"<64-hex>","token-factory":"<64-hex>"}
SOLANA_TOKEN_2022_VESTING_PROGRAM_ID=
SOLANA_LAUNCHPAD_ESCROW_PROGRAM_ID=

# Optional broader PowerChain program registry / Crisis programs.
SOLANA_PROGRAM_REGISTRY_JSON=[]
SOLANA_FUNDINGS_PROGRAM_ID=
SOLANA_STABLECOIN_PROGRAM_ID=
SOLANA_ORACLES_PROGRAM_ID=
SOLANA_SUPPLY_CHAIN_PROGRAM_ID=

# Provider quorum stability + rolling SLO
PROVIDER_QUORUM_FAILURE_HYSTERESIS=2
PROVIDER_QUORUM_RECOVERY_HYSTERESIS=2
READINESS_REQUIRE_SLO=false
SLO_WINDOW_SECONDS=300
SLO_MIN_SAMPLES=6
SLO_AVAILABILITY_TARGET_PCT=99.5
SLO_P95_TARGET_MS=1500
