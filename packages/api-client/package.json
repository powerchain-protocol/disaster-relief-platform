{
  "name": "@powerchain/crisis-api-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild": "pnpm --filter @powerchain/crisis-api-contract build",
    "pretypecheck": "pnpm --filter @powerchain/crisis-api-contract build"
  },
  "dependencies": {
    "@powerchain/crisis-api-contract": "workspace:*"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "description": "Typed browser/server client for PowerChain Crisis v1 APIs.",
  "author": "PowerChain Protocol",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
