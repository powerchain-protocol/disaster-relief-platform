{
  "schemaVersion": "1.1.0",
  "productVersion": "1.0.0",
  "slug": "launch-policy",
  "name": "Launch Policy",
  "family": "policy",
  "authorityDomain": "POLICY_CONTROL",
  "environmentVariable": "SOLANA_LAUNCH_POLICY_PROGRAM_ID",
  "fingerprintEnvironmentVariable": "SOLANA_LAUNCH_POLICY_PROGRAM_FINGERPRINT_SHA256",
  "requiredForStrictReadiness": true,
  "programId": null,
  "deploymentFingerprintSha256": null,
  "sourceOfTruth": "DEPLOYMENT_CONFIGURATION_AND_SOLANA_RPC",
  "status": "CONFIGURED_AT_DEPLOYMENT",
  "verificationPolicy": {
    "validateBase58PublicKey": true,
    "requireAccountExists": true,
    "requireExecutable": true,
    "requireRecognizedLoader": true,
    "inspectUpgradeableProgramData": true,
    "requirePinnedFingerprintInProduction": true
  },
  "changeControl": {
    "initialDeploymentMode": "INITIAL_DEPLOYMENT",
    "upgradeRequiresExactFingerprintTransition": true,
    "approvalRequiredInProduction": true
  },
  "note": "Production program IDs, upgrade metadata and executable fingerprints are deployment evidence, not source defaults."
}
